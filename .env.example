# Random secret (>= 32 chars) used to sign server-side values. Server-only.
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
# SQLite database file.
DATABASE_PATH=./data/nutripet.db
# Server-only token (>= 32 chars) required to create profiles or enroll devices after initial setup.
# Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SETUP_TOKEN=change-me-to-another-long-random-string-0123
# Secure flag on cookies. Defaults to true when NODE_ENV=production, false otherwise.
# Keep false only for local HTTP development (e.g. testing from a phone on the LAN).
COOKIE_SECURE=false
# Colombian food composition table import. Enable only after the ICBF license is verified.
TCAC_ENABLED=false
# User-Agent required by Open Food Facts for API requests.
OFF_USER_AGENT=NutriPet/0.1 (contact@example.com)
# Default time zone for new profiles.
APP_TIMEZONE_DEFAULT=America/Bogota
